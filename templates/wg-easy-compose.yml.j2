services:
  wg-easy:
    image: {{ wg_easy_image }}
    container_name: {{ wg_easy_container }}

    volumes:
      - ./wireguard:/etc/wireguard
      - /lib/modules:/lib/modules:ro

    ports:
      - "{{ wg_port }}:51820/udp"
      - "127.0.0.1:{{ wg_admin_port }}:51821/tcp"

    restart: unless-stopped

    cap_add:
      - NET_ADMIN
      - SYS_MODULE

    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
