#!/bin/bash

set -euo pipefail

ENV_FILE="/root/.secrets/cloudflare/ddns.env"

# --------------------------------------------------
# 設定ファイル読み込み
# --------------------------------------------------

if [[ ! -f "$ENV_FILE" ]]; then
    echo "ERROR: 設定ファイルがありません: $ENV_FILE"
    exit 1
fi

source "$ENV_FILE"

# 必須変数チェック
: "${CF_API_TOKEN:?CF_API_TOKEN が設定されていません}"
: "${CF_ZONE_NAME:?CF_ZONE_NAME が設定されていません}"
: "${CF_RECORD_NAMES:?CF_RECORD_NAMES が設定されていません}"

CF_TTL="${CF_TTL:-300}"

# --------------------------------------------------
# 現在のグローバルIPv4取得
# --------------------------------------------------

CURRENT_IP=$(curl -4 -fsS https://ifconfig.me/ip)

if [[ ! "$CURRENT_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "ERROR: グローバルIPv4を取得できませんでした: $CURRENT_IP"
    exit 1
fi

echo "現在のグローバルIPv4: $CURRENT_IP"

# --------------------------------------------------
# Cloudflare Zone ID取得
# --------------------------------------------------

ZONE_RESPONSE=$(curl -fsS \
    -H "Authorization: Bearer $CF_API_TOKEN" \
    -H "Content-Type: application/json" \
    "https://api.cloudflare.com/client/v4/zones?name=$CF_ZONE_NAME")

ZONE_ID=$(echo "$ZONE_RESPONSE" | jq -r '.result[0].id // empty')

if [[ -z "$ZONE_ID" ]]; then
    echo "ERROR: Zone IDを取得できませんでした"
    echo "$ZONE_RESPONSE" | jq
    exit 1
fi

# --------------------------------------------------
# 各DNSレコードを確認・更新
# --------------------------------------------------

for CF_RECORD_NAME in $CF_RECORD_NAMES; do

    echo
    echo "確認中: $CF_RECORD_NAME"

    RECORD_RESPONSE=$(curl -fsS \
        -H "Authorization: Bearer $CF_API_TOKEN" \
        -H "Content-Type: application/json" \
        "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records?type=A&name=$CF_RECORD_NAME")

    RECORD_ID=$(echo "$RECORD_RESPONSE" | jq -r '.result[0].id // empty')
    DNS_IP=$(echo "$RECORD_RESPONSE" | jq -r '.result[0].content // empty')

    if [[ -z "$RECORD_ID" ]]; then
        echo "ERROR: Aレコードが見つかりません: $CF_RECORD_NAME"
        continue
    fi

    echo "Cloudflare登録IPv4: $DNS_IP"

    # 変更なし
    if [[ "$CURRENT_IP" == "$DNS_IP" ]]; then
        echo "変更なし: $CF_RECORD_NAME"
        continue
    fi

    echo "IP変更検出: $DNS_IP -> $CURRENT_IP"

    UPDATE_RESPONSE=$(curl -fsS -X PUT \
        -H "Authorization: Bearer $CF_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data "$(jq -n \
            --arg name "$CF_RECORD_NAME" \
            --arg content "$CURRENT_IP" \
            --argjson ttl "$CF_TTL" \
            '{
                type: "A",
                name: $name,
                content: $content,
                ttl: $ttl,
                proxied: false
            }')" \
        "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records/$RECORD_ID")

    SUCCESS=$(echo "$UPDATE_RESPONSE" | jq -r '.success')

    if [[ "$SUCCESS" == "true" ]]; then
        echo "更新成功: $CF_RECORD_NAME -> $CURRENT_IP"
    else
        echo "ERROR: Cloudflare DNS更新に失敗しました: $CF_RECORD_NAME"
        echo "$UPDATE_RESPONSE" | jq
    fi

done
